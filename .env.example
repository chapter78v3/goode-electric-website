# Environment Variables Template
# Copy this file to .env and fill in the values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Email Configuration (Optional - for contact form emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@goodeelectric.com
RECIPIENT_EMAIL=contact@goodeelectric.com

# Google Maps API Key (Optional - for future map features)
MAPS_API_KEY=your-google-maps-api-key-here
